# MortyClaw 环境配置示例
# 复制为 .env 后填写本机配置；.env 已被 Git 忽略。

# ==================== DeepSeek Harness ====================

DEEPSEEK_API_KEY=
# 使用 DeepSeek 官方地址时保持为空；仅兼容代理需要填写。
DEEPSEEK_BASE_URL=
MORTYCLAW_HARNESS_MODEL=deepseek-v4-flash
MORTYCLAW_HARNESS_PROFILE=mortyclaw-sdk
MORTYCLAW_HARNESS_HOME=workspace/harness-home
MORTYCLAW_HARNESS_MAX_TOKENS=32768
MORTYCLAW_HARNESS_TURN_TIMEOUT_SECONDS=600
MORTYCLAW_HARNESS_MAX_CONCURRENCY=4
MORTYCLAW_APPROVAL_TTL_SECONDS=900

# ==================== 研究 MCP ====================

# Zotero 使用本机 Local API，第一版严格只读。
ZOTERO_MCP_ENABLED=0
ZOTERO_MCP_COMMAND=
ZOTERO_LOCAL=true
ZOTERO_MCP_TOOLSETS=none

# Arxiv 论文缓存只写入 workspace/arxiv-papers。
ARXIV_MCP_ENABLED=1
ARXIV_MCP_COMMAND=
ARXIV_MCP_STORAGE_PATH=workspace/arxiv-papers

# ==================== Agentic RAG ====================

# 普通对话不会连接 Qdrant 或加载 Embedding；只有模型调用 research_retrieve 时才会使用。
RESEARCH_RAG_ENABLED=0
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COMMAND=
QDRANT_STORAGE_PATH=workspace/qdrant
RESEARCH_COLLECTION=mortyclaw_research_v1
RESEARCH_EMBEDDING_MODEL=intfloat/multilingual-e5-large
RESEARCH_DENSE_CANDIDATES=30
RESEARCH_SPARSE_CANDIDATES=30
RESEARCH_DEFAULT_TOP_K=6
RESEARCH_MAX_TOP_K=10
RESEARCH_CACHE_TTL_SECONDS=7200

# ==================== 飞书 MCP ====================

FEISHU_MCP_ENABLED=0
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
FEISHU_MCP_TOOLS=preset.light
FEISHU_MCP_DOMAIN=https://open.feishu.cn
FEISHU_MCP_LANGUAGE=zh
FEISHU_MCP_TOKEN_MODE=tenant_access_token
FEISHU_MCP_OAUTH=0
# FEISHU_USER_ACCESS_TOKEN=

# ==================== 飞书聊天机器人 ====================

FEISHU_BOT_DM_ENABLED=1
FEISHU_BOT_GROUP_ENABLED=1
FEISHU_BOT_REQUIRE_MENTION=1
FEISHU_BOT_MAX_REPLY_CHARS=3500
