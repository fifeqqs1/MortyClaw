# CyberClaw 环境配置示例文件
# 复制此文件为 .env 并根据实际情况修改
# cp .env.example .env

# ==================== 模型配置 ====================

# 默认模型提供商 (可选：openai, anthropic, aliyun, tencent, z.ai, ollama, other)
DEFAULT_PROVIDER=openai

# 默认模型名称
DEFAULT_MODEL=gpt-5.4

# planner / route-classifier 轻量模型
# 不填写时会回退到 DEFAULT_MODEL
# ROUTE_CLASSIFIER_MODEL=gpt-5.4

# ==================== OpenAI 配置 ====================
# 仅在 DEFAULT_PROVIDER=openai / other 时默认使用
OPENAI_API_KEY=sk-your-api-key-here

# Base URL (可选，使用官方接口可留空或注释)
# OpenAI 官方：https://api.openai.com/v1
# ikuncode：https://api.ikuncode.cc/v1
OPENAI_API_BASE=https://api.ikuncode.cc/v1

# ==================== 阿里云 / Qwen 配置 ====================
# 仅在 DEFAULT_PROVIDER=aliyun / dashscope 时默认使用
# 如果配置了 ALIYUN_API_KEY，切换 DEFAULT_PROVIDER 时无需再手动覆盖 OPENAI_API_KEY
# ALIYUN_API_KEY=sk-your-qwen-api-key-here
# ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 也支持显式使用 DashScope 命名
# DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ==================== 其他兼容 Provider（可选） ====================
# 腾讯 / HunYuan
# TENCENT_API_KEY=your-tencent-key
# TENCENT_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1

# Z.AI
# ZAI_API_KEY=your-zai-key
# ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ==================== Anthropic 配置 ====================
# 仅在 DEFAULT_PROVIDER=anthropic 时使用

# API Key
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Base URL (可选，使用代理时配置)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ==================== Tavily 搜索配置 ====================
# 仅在需要联网搜索时使用

# Tavily API Key
TAVILY_API_KEY=tvly-your-api-key-here

# ==================== 研究 MCP 配置 ====================
# 安装：pip install -e ".[research-mcp]"

# Zotero 第一版严格只读，使用本机 Zotero 7+ 的 Local API。
ZOTERO_MCP_ENABLED=0
ZOTERO_MCP_COMMAND=
ZOTERO_LOCAL=true
ZOTERO_MCP_TOOLSETS=none

# Arxiv MCP 取代旧的 arxiv_rag HTTP 工具。
ARXIV_MCP_ENABLED=1
ARXIV_MCP_COMMAND=
ARXIV_MCP_STORAGE_PATH=workspace/arxiv-papers

# ==================== 飞书 MCP 配置 ====================
# 先在飞书开放平台创建应用，开通所需权限并发布应用。
# 然后执行 mortyclaw feishu-config，或手动填写以下配置。

FEISHU_MCP_ENABLED=0
# FEISHU_APP_ID=cli_xxxxxxxxxxxxx
# FEISHU_APP_SECRET=your-app-secret

# 建议先使用轻量工具集；也可改为 preset.default 或逗号分隔的具体工具名。
# 文档编辑工具清单见 README 的“连接飞书 MCP”章节；写操作仍需审批。
FEISHU_MCP_TOOLS=preset.light
FEISHU_MCP_DOMAIN=https://open.feishu.cn
FEISHU_MCP_LANGUAGE=zh

# 应用身份使用 tenant_access_token；访问个人文档、个人日历等使用 user_access_token。
FEISHU_MCP_TOKEN_MODE=tenant_access_token
FEISHU_MCP_OAUTH=0
# FEISHU_USER_ACCESS_TOKEN=u-xxxxxxxx

# ==================== 飞书聊天机器人 ====================
# 使用飞书事件订阅的长连接模式，不需要公网回调地址。
# 需在飞书开放平台启用长连接，订阅 im.message.receive_v1，
# 并开通 im:message 与 im:message:send_as_bot 后发布应用。
FEISHU_BOT_DM_ENABLED=1
FEISHU_BOT_GROUP_ENABLED=1
FEISHU_BOT_REQUIRE_MENTION=1
FEISHU_BOT_MAX_REPLY_CHARS=3500

# ==================== Ollama 配置 ====================
# 仅在 DEFAULT_PROVIDER=ollama 时使用

# Ollama 本地服务地址 (默认：http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434
